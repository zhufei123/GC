{
  "pages": [
    { "path": "pages/launch/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/login/index", "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" } }
  ],
  "subPackages": [
    {
      "root": "pages-customer",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "order/create", "style": { "navigationBarTitleText": "预约回收" } },
        { "path": "order/detail", "style": { "navigationBarTitleText": "订单详情" } },
        { "path": "address/list", "style": { "navigationBarTitleText": "地址管理" } },
        { "path": "address/edit", "style": { "navigationBarTitleText": "编辑地址" } },
        { "path": "store/nearby", "style": { "navigationBarTitleText": "附近回收站" } },
        { "path": "store/detail", "style": { "navigationBarTitleText": "回收站详情" } },
        { "path": "store/quotes", "style": { "navigationBarTitleText": "门店比价" } }
      ]
    },
    {
      "root": "pages-recycler",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "order/handle", "style": { "navigationBarTitleText": "称重录入" } },
        { "path": "order/detail", "style": { "navigationBarTitleText": "订单详情" } },
        { "path": "price/index", "style": { "navigationBarTitleText": "本站报价" } },
        { "path": "apply/index", "style": { "navigationBarTitleText": "入驻申请" } },
        { "path": "apply/result", "style": { "navigationBarTitleText": "审核状态" } }
      ]
    }
  ],
  "preloadRule": {
    "pages/login/index": { "network": "all", "packages": ["pages-customer"] }
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^app-(.*)": "@/components/app-$1/app-$1.vue"
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "绿色回收",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f6f8"
  }
}
