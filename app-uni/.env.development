VITE_API_BASE_URL=http://127.0.0.1:8080
# 地图提供商: amap | qqmap | osm(key 缺失时按 amap → qqmap → osm 降级)
VITE_MAP_PROVIDER=amap
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_MAP_QQ_KEY=
# 微信订阅消息模板 id(接单/称重/完成)，为空的条目跳过 requestSubscribeMessage
VITE_WX_TMPL_ACCEPT=
VITE_WX_TMPL_WEIGHED=
VITE_WX_TMPL_COMPLETED=
# 支付宝订阅消息 entityId(接单/称重/完成)，为空的条目跳过
VITE_ALIPAY_TMPL_ACCEPT=
VITE_ALIPAY_TMPL_WEIGHED=
VITE_ALIPAY_TMPL_COMPLETED=
# 微信商户号(商家转账确认收款用)，为空则 requestMerchantTransfer 不带 mchId
VITE_WX_MCH_ID=
